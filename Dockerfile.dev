# Desarrollo: Vite con hot-reload dentro del contenedor.
FROM node:22-alpine

WORKDIR /app

# Las dependencias se instalan en una capa aparte para aprovechar la caché.
COPY package.json package-lock.json* ./
RUN npm install

COPY . .

EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
